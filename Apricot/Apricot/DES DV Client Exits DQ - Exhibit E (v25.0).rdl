  <DataSets>
    <DataSet Name="DES_DV_monthly_02_data">
      <Query>
        <DataSourceName>LeafReport</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ReportPeriodStart">
            <Value>=Parameters!ReportPeriodStart.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ReportPeriodEnd">
            <Value>=Parameters!ReportPeriodEnd.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT *
FROM apr.DES_DV_monthly_02_data
WHERE ServiceEndDate BETWEEN @ReportPeriodStart AND @ReportPeriodEnd</CommandText>
      </Query>
      <Fields>
        <Field Name="Client_RecordID">
          <DataField>Client_RecordID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
